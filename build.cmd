oop.menu.suivant.png -resource:assets\menu\synchro.png,MWCoop.menu.synchro.png -resource:assets\menu\tchat.png,MWCoop.menu.tchat.png -resource:assets\menu\venir.png,MWCoop.menu.venir.png -resource:assets\menu\voiture.png,MWCoop.menu.voiture.png -resource:assets\ceintures\arr-base.mwm,MWCoop.arr-base.mwm -resource:assets\ceintures\arr-rangee-g.mwm,MWCoop.arr-rangee-g.mwm -resource:assets\ceintures\arr-bouclee-g.mwm,MWCoop.arr-bouclee-g.mwm -resource:assets\ceintures\arr-rangee-d.mwm,MWCoop.arr-rangee-d.mwm -resource:assets\ceintures\arr-bouclee-d.mwm,MWCoop.arr-bouclee-d.mwm -resource:assets\drone\drone-corps.mwm,MWCoop.drone-corps.mwm -resource:assets\drone\drone-helice0.mwm,MWCoop.drone-helice0.mwm -resource:assets\drone\drone-helice1.mwm,MWCoop.drone-helice1.mwm -resource:assets\drone\drone-helice2.mwm,MWCoop.drone-helice2.mwm -resource:assets\drone\drone-helice3.mwm,MWCoop.drone-helice3.mwm -resource:assets\kino\kino-kyltti.png,MWCoop.kauppa.kino-kyltti.png -resource:assets\kino\kino-valkokangas.png,MWCoop.kauppa.kino-valkokangas.png -resource:assets\kino\kino-hinnasto.png,MWCoop.kauppa.kino-hinnasto.png -resource:assets\kino\kino-sali1.png,MWCoop.kauppa.kino-sali1.png -resource:assets\kino\kino-sali2.png,MWCoop.kauppa.kino-sali2.png -resource:assets\kino\kino-konehuone.png,MWCoop.kauppa.kino-konehuone.png -resource:assets\kino\kino-ulos.png,MWCoop.kauppa.kino-ulos.png -resource:assets\kino\kino-juliste1.png,MWCoop.kauppa.kino-juliste1.png -resource:assets\kino\kino-juliste2.png,MWCoop.kauppa.kino-juliste2.png -resource:assets\kino\kino-juliste3.png,MWCoop.kauppa.kino-juliste3.png -resource:assets\kino\kino-juliste4.png,MWCoop.kauppa.kino-juliste4.png -resource:assets\kino\kino-juliste5.png,MWCoop.kauppa.kino-juliste5.png -resource:assets\kino\kino-juliste6.png,MWCoop.kauppa.kino-juliste6.png -resource:assets\kino\kino-popcorn.png,MWCoop.kauppa.kino-popcorn.png -resource:assets\kino\kino-sipsit.png,MWCoop.kauppa.kino-sipsit.png -resource:assets\kino\kino-limsa.png,MWCoop.kauppa.kino-limsa.png -resource:assets\kino\kino-karkit.png,MWCoop.kauppa.kino-karkit.png -resource:assets\kino\kino-kela.png,MWCoop.kauppa.kino-kela.png -resource:assets\kino\kino-hintalappu-kela.png,MWCoop.kauppa.kino-hintalappu-kela.png -resource:assets\kino\kino-sisaan.png,MWCoop.kauppa.kino-sisaan.png -resource:assets\kino\kino-ulosajo.png,MWCoop.kauppa.kino-ulosajo.png -resource:assets\osat\osat-kyltti.png,MWCoop.kauppa.osat-kyltti.png -resource:assets\osat\osat-cardinal.png,MWCoop.kauppa.osat-cardinal.png -resource:assets\osat\osat-kaytetyt.png,MWCoop.kauppa.osat-kaytetyt.png -resource:assets\osat\osat-nouto.png,MWCoop.kauppa.osat-nouto.png -resource:assets\osat\osat-paita.png,MWCoop.kauppa.osat-paita.png -recurse:src\MWCoop\*.cs || exit /b 1
