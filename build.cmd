@echo off
rem Compile MWCoop : build\version.dll (chargeur x64), build\MWCoop.dll (mod, .NET 3.5 / Mono d'Unity 5)
rem et build\MWCoop.exe (lanceur). Le mod se compile contre les DLL du jeu : MWC_JEU = dossier du jeu.
setlocal
cd /d "%~dp0"
if not defined MWC_JEU set "MWC_JEU=C:\Program Files (x86)\Steam\steamapps\common\My Winter Car"
set "MANAGED=%MWC_JEU%\mywintercar_Data\Managed"
if not exist "%MANAGED%\UnityEngine.dll" goto :pasdejeu
if not exist build mkdir build

call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvars64.bat" >nul || exit /b 1

rem Version du lanceur (launcher\version.txt, flux lanceur- depuis 1.15.0 ; dist\make-release.ps1 -Jeu lanceur l'ecrit) dans les
rem informations de version de MWCoop.exe et de version.dll (chargeur, livre dans l'exe). Le mod a la sienne (Version.cs).
set /p MWV=<launcher\version.txt
set "MWV=%MWV: =%"
for /f "tokens=1-3 delims=.-" %%a in ("%MWV%") do set "MWVN=%%a,%%b,%%c,0"
> build\mwversion.h echo #define MWV_NUM %MWVN%
>> build\mwversion.h echo #define MWV_STR "%MWV%"
rc /nologo /i build /fo build\loader.res loader\loader.rc || exit /b 1
ml64 /nologo /c /Fobuild\exports.obj loader\exports.asm || exit /b 1
cl /nologo /O2 /MT /W3 /utf-8 /D_CRT_SECURE_NO_WARNINGS /DUNICODE /D_UNICODE /Fobuild\ loader\proxy.cpp build\exports.obj build\loader.res ^
   /LD /Febuild\version.dll /link /DEF:loader\version.def user32.lib kernel32.lib advapi32.lib shell32.lib shlwapi.lib ole32.lib || exit /b 1
echo OK build\version.dll
rem Ray tracing : MWCoopRT.dll (plugin natif d'Unity, mywintercar_Data\Plugins), DXR par Direct3D 12
"C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\dxc.exe" -nologo -T cs_6_5 -E Main -Fh build\rt_shadow.h -Vn g_rtShadow rt\shadow.hlsl || exit /b 1
"C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\dxc.exe" -nologo -T cs_6_5 -E Main -Fh build\rt_lamps.h -Vn g_rtLamps rt\lamps.hlsl || exit /b 1
cl /nologo /O2 /MT /W3 /EHsc /utf-8 /D_CRT_SECURE_NO_WARNINGS /I build /Fobuild\ rt\mwcrt.cpp rt\mwcvideo.cpp rt\mwcstream.cpp /LD /Febuild\MWCoopRT.dll /link d3d11.lib d3d12.lib dxgi.lib d3dcompiler.lib mfplat.lib mfreadwrite.lib mfuuid.lib windowscodecs.lib ole32.lib oleaut32.lib propsys.lib delayimp.lib /DELAYLOAD:mfplat.dll /DELAYLOAD:mfreadwrite.dll || exit /b 1
echo OK build\MWCoopRT.dll

dotnet "%ProgramFiles%\dotnet\sdk\8.0.424\Roslyn\bincore\csc.dll" -nologo -noconfig -nostdlib -target:library -optimize -langversion:7.3 ^
   -nowarn:1701,1702 -out:build\MWCoop.dll ^
   -r:"%MANAGED%\mscorlib.dll" -r:"%MANAGED%\System.dll" -r:"%MANAGED%\System.Core.dll" ^
   -r:"%MANAGED%\UnityEngine.dll" -r:"%MANAGED%\PlayMaker.dll" -r:"%MANAGED%\Assembly-CSharp.dll" -r:"%MANAGED%\Assembly-CSharp-firstpass.dll" ^
   -resource:launcher\logo-titre.png,MWCoop.logo-titre.png -resource:launcher\logo-msc.png,MWCoop.logo-msc.png -resource:assets\sac\sac-plie.mwm,MWCoop.sac-plie.mwm -resource:assets\sac\sac-deplie.mwm,MWCoop.sac-deplie.mwm -resource:assets\sac\sac.jpg,MWCoop.sac.jpg -resource:assets\kauppa\enseigne.png,MWCoop.kauppa.enseigne.png -resource:assets\kauppa\affiche-video.png,MWCoop.kauppa.affiche-video.png -resource:assets\kauppa\affiche-horaires.png,MWCoop.kauppa.affiche-horaires.png -resource:assets\kauppa\affiche-makuupussi.png,MWCoop.kauppa.affiche-makuupussi.png -resource:assets\kauppa\hintalappu-makuupussi.png,MWCoop.kauppa.hintalappu-makuupussi.png -resource:assets\kauppa\myyja-paita.png,MWCoop.kauppa.myyja-paita.png -resource:assets\kauppa\pussi.png,MWCoop.kauppa.pussi.png -resource:assets\kauppa\lippu-korsika.png,MWCoop.kauppa.lippu-korsika.png -resource:assets\kauppa\museo-kyltti.png,MWCoop.kauppa.museo-kyltti.png -resource:assets\kauppa\vhs-kansi.png,MWCoop.kauppa.vhs-kansi.png -resource:assets\kauppa\vhs-selka.png,MWCoop.kauppa.vhs-selka.png -resource:assets\kauppa\nauhuri-etu.png,MWCoop.kauppa.nauhuri-etu.png -resource:assets\kauppa\hintalappu-vhs.png,MWCoop.kauppa.hintalappu-vhs.png -resource:assets\kauppa\hintalappu-nauhuri.png,MWCoop.kauppa.hintalappu-nauhuri.png -resource:assets\kauppa\hintalappu-tv.png,MWCoop.kauppa.hintalappu-tv.png -resource:assets\kauppa\kamera-sivu.png,MWCoop.kauppa.kamera-sivu.png -resource:assets\kauppa\hintalappu-kamera.png,MWCoop.kauppa.hintalappu-kamera.png -resource:assets\kauppa\hintalappu-kartturi.png,MWCoop.kauppa.hintalappu-kartturi.png -resource:assets\kauppa\konsoli-kyltti.png,MWCoop.kauppa.konsoli-kyltti.png -resource:assets\kauppa\pelit-kannet.png,MWCoop.kauppa.pelit-kannet.png -resource:assets\kauppa\konsoli-demo.png,MWCoop.kauppa.konsoli-demo.png -resource:assets\kauppa\konsoli-laatikko.png,MWCoop.kauppa.konsoli-laatikko.png -resource:assets\kauppa\olut-etiketti.png,MWCoop.kauppa.olut-etiketti.png -resource:assets\ka